<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingLeft="112dp" android:paddingRight="14dp"
    android:paddingTop="12dp" android:paddingBottom="12dp" android:background="#FF101820">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <FrameLayout android:layout_width="44dp" android:layout_height="44dp" android:background="#FF22324C">
            <TextView android:id="@+id/rear_initial" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:textColor="#FF91B9FA" android:textSize="23sp" />
            <android.widget.ImageView android:id="@+id/rear_avatar" android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:contentDescription="人员头像" android:visibility="gone" />
        </FrameLayout>
        <TextView android:id="@+id/rear_name" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="24sp"
            android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="2" android:ellipsize="end" />
        <android.widget.ImageView android:id="@+id/rear_close" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="10dp" android:src="@drawable/ic_close" android:tint="#FFB9C4D2" android:contentDescription="关闭背屏卡片" />
    </LinearLayout>
    <TextView android:id="@+id/rear_post" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="#FF91B9FA" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/rear_org" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#FFFFFFFF" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/rear_path" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#FFB9C4D2" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/rear_more" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#FFB9C4D2" android:visibility="gone" />
</LinearLayout>
